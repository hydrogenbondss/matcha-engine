################################################################################
## SIDE PORTRAITS — Side B treated variants
## ============================================================
## Loads the treated side-portrait images (amber ring, desaturated, clipped
## to a soft circle) generated by handoff/side_portrait_treatment.py.
##
## With `gui.use_side_image = True` in gui.rpy, Ren'Py auto-displays whichever
## `side <char>` image is defined for the currently speaking character. By
## defining the new treated images with the SAME names as the originals, the
## old files are shadowed — no other code in the game needs to change.
##
## INSTALL:
##   1. Run handoff/side_portrait_treatment.py --apply  (generates
##      images/side_treated/side_*.png).
##   2. Drop this file into game/.
##   3. renpy lint should still pass.
##
## To revert: delete this file. Original `side X.png` files are untouched.
################################################################################

# KEEP air-above via transform on the same cropped PNG (no new image).
image side blake          = _li_circle_lock("images/side_treated/side_blake.png")
image side blake_female   = _li_circle_lock("images/side_treated/side_blake_female.png")
image side kite_male      = _li_circle_lock("images/side_treated/side_kite_male.png")
image side kite_female    = _li_circle_lock("images/side_treated/side_kite_female.png")
image side neo            = _li_circle_lock("images/side_treated/side_neo.png")
image side nia            = _li_circle_lock("images/side_treated/side_nia.png")
image side remy           = _li_circle_lock("images/side_treated/side_remy.png")
image side barbie         = "images/side_treated/side_barbie.png"
image side dad            = "images/side_treated/side_dad.png"
image side derek          = "images/side_treated/side_derek.png"
image side marcus         = "images/side_treated/side_marcus.png"
image side may            = "images/side_treated/side_may.png"

# Player side portrait — use the existing one as-is for now. If you want
# it treated too, run the script with `--include-p` (not implemented; rename
# `side p.png` → `side player.png` and add the line above).
# image side p              = "images/side_treated/side_p.png"
